/// ERP customers: trimmed, codes upper-cased, dates typed with the en-NZ locale
expression stg_Customers =
		let
		    Source = Csv.Document(File.Contents(FilePath & "\ERP\Customers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    // ERP text has trailing spaces; codes upper-cased so they match across extracts
		    Trimmed = Table.TransformColumns(PromotedHeaders, {}, Text.Trim),
		    UpperCodes = Table.TransformColumns(Trimmed, {{"CustomerCode", Text.Upper, type text}}),
		    // ERP dates are dd/mm/yyyy, so the type change uses the en-NZ locale
		    Typed = Table.TransformColumnTypes(UpperCodes, {
		        {"CustomerName", type text}, {"Channel", type text}, {"City", type text}, {"Region", type text},
		        {"Country", type text}, {"PaymentTerms", type text}, {"CreatedDate", type date}, {"Active", type text}
		    }, "en-NZ")
		in
		    Typed
	lineageTag: 49ff33a8-5d2f-471f-80a3-b943ab4ee5da
	queryGroup: 'Source Files'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

/// ERP items: trimmed, codes and product group upper-cased, blank stem lengths set to null
expression stg_Items =
		let
		    Source = Csv.Document(File.Contents(FilePath & "\ERP\Items.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Trimmed = Table.TransformColumns(PromotedHeaders, {}, Text.Trim),
		    // ProductGroup arrives in mixed case (ROSES, Lilies); item codes upper-cased for matching
		    UpperText = Table.TransformColumns(Trimmed, {{"ItemCode", Text.Upper, type text}, {"ProductGroup", Text.Upper, type text}}),
		    // Gift and mixed items have no stem length
		    BlankToNull = Table.ReplaceValue(UpperText, "", null, Replacer.ReplaceValue, {"StemLengthCm"}),
		    Typed = Table.TransformColumnTypes(BlankToNull, {
		        {"ItemDescription", type text}, {"StemLengthCm", Int64.Type}, {"StemsPerBunch", Int64.Type}, {"UOM", type text},
		        {"ListPriceNZD", Currency.Type}, {"CreatedDate", type date}, {"Active", type text}
		    }, "en-NZ")
		in
		    Typed
	lineageTag: 4c952cd2-19e3-4da7-b2a2-8a1f9f8f6a21
	queryGroup: 'Source Files'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

