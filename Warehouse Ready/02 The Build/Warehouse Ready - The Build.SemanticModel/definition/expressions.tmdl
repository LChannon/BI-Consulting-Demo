/// Packhouse pack-out: grade code G60 split out to a stem length so it can match the ERP item
expression stg_PackOut =
		let
		    Source = Csv.Document(File.Contents(FilePath & "\Production\PackOut.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Trimmed = Table.TransformColumns(PromotedHeaders, {}, Text.Trim),
		    UpperCodes = Table.TransformColumns(Trimmed, {
		        {"PackLine", Text.Upper, type text}, {"VarietyCode", Text.Upper, type text}, {"GradeCode", Text.Upper, type text}
		    }),
		    // The packhouse codes grades as G40, G60...; the ERP holds the same thing as a number in StemLengthCm
		    StemLength = Table.AddColumn(UpperCodes, "StemLengthCm", each Number.From(Text.Range([GradeCode], 1)), Int64.Type),
		    Typed = Table.TransformColumnTypes(StemLength, {
		        {"PackDate", type date}, {"BunchSize", Int64.Type}, {"BunchesPacked", Int64.Type}, {"StemsRejected", Int64.Type}
		    }, "en-NZ")
		in
		    Typed
	lineageTag: f5c17f85-f456-4698-acb7-28254ed3e719
	queryGroup: 'Source Files'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

/// Hand-kept product mapping: ERP item to variety, variety default item and range
expression stg_ProductMapping =
		let
		    Source = Excel.Workbook(File.Contents(FilePath & "\Manual\ProductMapping.xlsx"), null, true){[Item = "Mapping", Kind = "Sheet"]}[Data],
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    // Typed in by hand: some variety codes are lower case or have trailing spaces
		    Cleaned = Table.TransformColumns(PromotedHeaders, {
		        {"ItemCode", each Text.Upper(Text.Trim(Text.From(_))), type text},
		        {"ItemDescription", each Text.Trim(Text.From(_)), type text},
		        {"VarietyCode", each if _ = null then null else Text.Upper(Text.Trim(Text.From(_))), type text},
		        {"VarietyDefault", each _ = "Y", type logical},
		        {"Range", each Text.Trim(Text.From(_)), type text},
		        {"MappedBy", each Text.Trim(Text.From(_)), type text}
		    }),
		    Typed = Table.TransformColumnTypes(Cleaned, {{"MappedDate", type date}})
		in
		    Typed
	lineageTag: 11edaf54-021a-4db0-a458-5e3d390afc1f
	queryGroup: 'Source Files'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

