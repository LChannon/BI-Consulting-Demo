		    Source = Excel.Workbook(File.Contents(FilePath & "\Manual\ProductMapping.xlsx"), null, true){[Item = "Range List", Kind = "Sheet"]}[Data],
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(PromotedHeaders, {
		        {"Range", type text}, {"SortOrder", Int64.Type}, {"Description", type text}
		    })
