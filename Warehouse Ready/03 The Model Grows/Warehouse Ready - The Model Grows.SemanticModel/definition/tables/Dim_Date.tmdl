	column MonthsBack
		dataType: int64
		formatString: 0
		lineageTag: 5e5bfd3f-d0cf-4960-922e-1240dfab4a2c
		summarizeBy: sum
		sourceColumn: MonthsBack

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = m
		mode: import
		queryGroup: 'Report Tables'
		source = ```
				let
				    //Pick up dates from existing tables
				    YearCount = Duration.Days(Duration.From(Date.From(Text.From(End_Year)&"-12-31")-Date.From(Text.From(Start_Year)&"-01-01")))+1,
				    ListDays = List.Dates(Date.From(Text.From(Start_Year)&"-01-01"),YearCount,#duration(1,0,0,0)),
				    ToTable = Table.FromList(ListDays, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
				    RenCols = Table.RenameColumns(ToTable,{{"Column1", "Date"}}),
				    ChgType = Table.TransformColumnTypes(RenCols,{{"Date", type date}}),
				
				    //Create date related fields for use in reporting
				    DateCode = Table.AddColumn(ChgType, "DateCode", each Date.Year([Date])*10000+Date.Month([Date])*100+Date.Day([Date]), Int64.Type),
				    Year = Table.AddColumn(DateCode, "Year", each Date.Year([Date]), type any),
				    YearNo = Table.AddColumn(Year, "YearNo", each Date.Year([Date]), Int64.Type),
				    FYSM = Table.AddColumn(YearNo, "FYSM", each FinYearStart),
				    MonthOfYearNo = Table.AddColumn(FYSM, "MonthOfYearNo", each Date.Month([Date]), Int64.Type),
				    FYear = Table.AddColumn(MonthOfYearNo, "FYear", each if [MonthOfYearNo] >= [FYSM] then [YearNo]+1 else [YearNo], type any),
				    FinMonthOfYearNo = Table.AddColumn(FYear, "FinMonthOfYearNo", each if [MonthOfYearNo] < [FYSM] then 12 - [FYSM] + [MonthOfYearNo] + 1 else [MonthOfYearNo] - [FYSM] + 1, Int64.Type),
				    MonthOfYear = Table.AddColumn(FinMonthOfYearNo, "MonthOfYear", each Date.MonthName([Date]), type text),
				    MonthOfYearShort = Table.AddColumn(MonthOfYear, "MonthOfYearShort", each Text.Range(Date.MonthName([Date]),0,3), type text),
				    MonthNo = Table.AddColumn(MonthOfYearShort, "MonthNo", each [FYear] * 100 + [FinMonthOfYearNo], Int64.Type),
				    Month = Table.AddColumn(MonthNo, "Month", each Date.MonthName([Date]) & " " & Text.From(Date.Year([Date])), type text),
				    MonthShort = Table.AddColumn(Month, "MonthShort", each Text.Range(Date.MonthName([Date]),0,3) &" "& Text.From(Date.Year([Date])), type text),
				    WeekOfYear = Table.AddColumn(MonthShort, "WeekOfYear", each Date.WeekOfYear([Date],Day.Monday), type any),
				    WeekOfMonth = Table.AddColumn(WeekOfYear, "WeekOfMonth", each Date.WeekOfMonth([Date]), type any),
				    WeekNo = Table.AddColumn(WeekOfMonth, "WeekNo", each Date.Year([Date])*100+Date.WeekOfYear([Date],Day.Monday), Int64.Type),
				    Week = Table.AddColumn(WeekNo, "Week", each "W" & Text.From(Date.WeekOfYear([Date],Day.Monday)) & " " & Text.From(Date.Year([Date])), type text),
				    
				    FYearNo = Table.AddColumn(Week, "FYearNo", each [FYear], Int64.Type),
				    FYearName = Table.AddColumn(FYearNo, "FYearName", each "FY " & Number.ToText([FYearNo]-1) & "/" & Text.Range(Number.ToText([FYear]),2), type text),
				
				    DateFormat = Table.AddColumn(FYearName, "DateFormat", each Date.From([Date]), type date),
				    EOW_Date = Table.AddColumn(DateFormat, "EOW_Date", each Date.EndOfWeek([Date],Day.Monday), type date),
				    EOM_Date = Table.AddColumn(EOW_Date, "EOM_Date", each Date.EndOfMonth([Date]), type date),
				    DayOfYear = Table.AddColumn(EOM_Date, "DayOfYear", each Date.DayOfYear([Date]), type any),
				    DayOfWeekNo = Table.AddColumn(DayOfYear, "DayOfWeekNo", each Date.DayOfWeek([Date],Day.Monday), Int64.Type),
				    DayOfMonthNo = Table.AddColumn(DayOfWeekNo, "DayOfMonthNo", each Date.Day([Date]), Int64.Type),
				    DayType = Table.AddColumn(DayOfMonthNo, "DayType", each if [DayOfWeekNo] < 5 then "WeekDay" else "WeekEnd", type text),
				    Day = Table.AddColumn(DayType, "Day", each Date.DayOfWeekName([Date]), type text),
				    DayShort = Table.AddColumn(Day, "DayShort", each Text.Range(Date.DayOfWeekName([Date]),0,3), type text),
				
				    //Date Filter Calculations
				    Today = Table.AddColumn(DayShort, "Today", each if Date.From(DateTimeZone.LocalNow()) = [Date] then 1 else 0),
				    FilterToday = Table.SelectRows(Today, each ([Today] = 1)),
				    
				    LastWeek = Table.AddColumn(DayShort, "LastWeek", each if Date.AddDays(Date.From(DateTimeZone.LocalNow()),-7) = [Date] then 1 else 0),
				    FilterLastWeek = Table.SelectRows(LastWeek, each ([LastWeek] = 1)),
				    
				    NextWeek = Table.AddColumn(DayShort, "NextWeek", each if Date.AddDays(Date.From(DateTimeZone.LocalNow()),7) = [Date] then 1 else 0),
				    FilterNextWeek = Table.SelectRows(NextWeek, each ([NextWeek] = 1)),
				    
				    LastMonth = Table.AddColumn(DayShort, "LastMonth", each if Date.AddMonths(Date.From(DateTimeZone.LocalNow()),-1) = [Date] then 1 else 0),
				    FilterLastMonth = Table.SelectRows(LastMonth, each ([LastMonth] = 1)),
				    
				    NextMonth = Table.AddColumn(DayShort, "NextMonth", each if Date.AddMonths(Date.From(DateTimeZone.LocalNow()),1) = [Date] then 1 else 0),
				    FilterNextMonth = Table.SelectRows(NextMonth, each ([NextMonth] = 1)),
				
				    LastYear = Table.AddColumn(DayShort, "LastYear", each if Date.AddYears(Date.From(DateTimeZone.LocalNow()),-1) = [Date] then 1 else 0),
				    FilterLastYear = Table.SelectRows(LastYear, each ([LastYear] = 1)),
				    
				    NextYear = Table.AddColumn(DayShort, "NextYear", each if Date.AddYears(Date.From(DateTimeZone.LocalNow()),1) = [Date] then 1 else 0),
				    FilterNextYear = Table.SelectRows(NextYear, each ([NextYear] = 1)),
				
				    LastFYear = Table.AddColumn(DayShort, "LastFYear", each if Date.AddYears(Date.From(DateTimeZone.LocalNow()),-1) = [Date] then 1 else 0),
				    FilterLastFYear = Table.SelectRows(LastFYear, each ([LastFYear] = 1)),
				    
				    NextFYear = Table.AddColumn(DayShort, "NextFYear", each if Date.AddYears(Date.From(DateTimeZone.LocalNow()),1) = [Date] then 1 else 0),
				    FilterNextFYear = Table.SelectRows(NextFYear, each ([NextFYear] = 1)),
				
				    DayFilter = Table.AddColumn(DayShort, "DayFilter", each if Date.From(DateTimeZone.LocalNow()) = [Date] then "Today" else if Date.AddDays(Date.From(DateTimeZone.LocalNow()),-1) = [Date] then "Yesterday" else if Date.AddDays(Date.From(DateTimeZone.LocalNow()),1) = [Date] then "Tomorrow" else "", type text),
				    WeekFilter = Table.AddColumn(DayFilter, "WeekFilter", each if List.Max(#"FilterToday"[WeekNo]) = [WeekNo] then "Current Week" else if List.Max(#"FilterLastWeek"[WeekNo]) = [WeekNo] then "Last Week" else if List.Max(#"FilterNextWeek"[WeekNo]) = [WeekNo] then "Next Week" else "", type text),
				    MonthFilter = Table.AddColumn(WeekFilter, "MonthFilter", each if List.Max(#"FilterToday"[MonthNo]) = [MonthNo] then "Current Month" else if List.Max(#"FilterLastMonth"[MonthNo]) = [MonthNo] then "Last Month" else if List.Max(#"FilterNextMonth"[MonthNo]) = [MonthNo] then "Next Month" else "", type text),
				    YearFilter = Table.AddColumn(MonthFilter, "YearFilter", each if List.Max(#"FilterToday"[YearNo]) = [YearNo] then "Current Year" else if List.Max(#"FilterLastYear"[YearNo]) = [YearNo] then "Last Year" else if List.Max(#"FilterNextYear"[YearNo]) = [YearNo] then "Next Year" else "", type text),
				    FYearFilter = Table.AddColumn(YearFilter, "FYearFilter", each if List.Max(#"FilterToday"[FYearNo]) = [FYearNo] then "Current Fin Year" else if List.Max(#"FilterLastFYear"[FYearNo]) = [FYearNo] then "Last Fin Year" else if List.Max(#"FilterNextFYear"[FYearNo]) = [FYearNo] then "Next Fin Year" else "", type text),
				    YearsBack = Table.AddColumn(FYearFilter, "YearsBack", each [FYearNo] - List.Max(#"FilterToday"[FYearNo]), Int64.Type),
				    MonthsBack = Table.AddColumn(YearsBack, "MonthsBack", each (-([FYear] - List.Max(#"FilterToday"[FYearNo])) * 100) + ([MonthNo] - List.Max(#"FilterToday"[MonthNo])) - (- ([FYear] - List.Max(#"FilterToday"[FYearNo])) * 12), Int64.Type),
				    RemovedColumns = Table.RemoveColumns(MonthsBack,{"FYSM"})
				in
				    RemovedColumns
				```

	annotation PBI_ResultType = Table

