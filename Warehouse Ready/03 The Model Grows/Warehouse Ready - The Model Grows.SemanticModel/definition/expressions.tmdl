/// Sales budget: three year sheets appended, title rows skipped, months unpivoted. One row per range and month
expression stg_Budget =
		let
		    Source = Excel.Workbook(File.Contents(FilePath & "\Manual\Budget.xlsx"), null, true),
		    // One sheet per financial year: FY24, FY25, FY26
		    YearSheets = Table.SelectRows(Source, each [Kind] = "Sheet" and Text.StartsWith([Name], "FY")),
		    // Each sheet has a title and an approval line above the header row, so skip down to the row starting "Range"
		    Cleaned = Table.AddColumn(YearSheets, "Rows", each
		        let
		            Raw = [Data],
		            FromHeader = Table.Skip(Raw, (r) => r[Column1] <> "Range"),
		            Promoted = Table.PromoteHeaders(FromHeader, [PromoteAllScalars = true]),
		            NoTotal = Table.RemoveColumns(Promoted, {"Total"}, MissingField.Ignore)
		        in
		            Table.UnpivotOtherColumns(NoTotal, {"Range", "Measure"}, "MonthLabel", "Value")),
		    Combined = Table.Combine(Cleaned[Rows]),
		    // Month headers read like Apr-24
		    MonthNames = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"},
		    MonthStart = Table.AddColumn(Combined, "MonthStart", each
		        #date(2000 + Number.From(Text.End([MonthLabel], 2)), List.PositionOf(MonthNames, Text.Start([MonthLabel], 3)) + 1, 1), type date),
		    Trimmed = Table.TransformColumns(MonthStart, {{"Range", Text.Trim, type text}, {"Measure", Text.Trim, type text}}),
		    NoLabel = Table.RemoveColumns(Trimmed, {"MonthLabel"}),
		    Pivoted = Table.Pivot(NoLabel, {"Bunches", "Revenue NZD"}, "Measure", "Value", List.Sum),
		    Renamed = Table.RenameColumns(Pivoted, {{"Revenue NZD", "RevenueNZD"}}),
		    Typed = Table.TransformColumnTypes(Renamed, {{"Bunches", type number}, {"RevenueNZD", type number}})
		in
		    Typed
	lineageTag: 13770937-478a-459f-86b2-da7dedcb9300
	queryGroup: 'Source Files'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

