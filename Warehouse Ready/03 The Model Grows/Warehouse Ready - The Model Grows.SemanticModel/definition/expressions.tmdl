/// Packhouse varieties: trimmed, names and colours in proper case, ISO dates
expression stg_Varieties =
		let
		    Source = Csv.Document(File.Contents(FilePath & "\Production\Varieties.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Trimmed = Table.TransformColumns(PromotedHeaders, {}, Text.Trim),
		    // Names and colours arrive in mixed case (SNOWDRIFT, red); codes upper-cased for matching
		    Cased = Table.TransformColumns(Trimmed, {
		        {"VarietyCode", Text.Upper, type text}, {"VarietyName", Text.Proper, type text},
		        {"Crop", Text.Proper, type text}, {"Colour", Text.Proper, type text}
		    }),
		    Typed = Table.TransformColumnTypes(Cased, {{"IntroducedDate", type date}, {"Active", type text}}, "en-NZ")
		in
		    Typed
